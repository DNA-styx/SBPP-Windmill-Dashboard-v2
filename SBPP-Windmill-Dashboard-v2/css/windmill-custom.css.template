/*
 * SBPP Windmill Dashboard v2 — Custom colour variant template
 *
 * Instructions:
 *   1. Copy this file to windmill-custom.css
 *   2. Replace the hex values below with your chosen brand colour scale
 *   3. In core/header.tpl, uncomment windmill-custom.css and comment
 *      out whichever other variant is currently active
 *
 * To generate a full scale from a single hex colour, use:
 *   https://uicolors.app  or  https://www.tints.dev
 *
 * The values below use Tailwind violet-600 as a starting point.
 * Replace all of them with your own scale.
 */

:root {
    --brand-50:  #f5f3ff;  /* lightest tint — used for soft backgrounds  */
    --brand-100: #ede9fe;
    --brand-200: #ddd6fe;
    --brand-300: #c4b5fd;
    --brand-400: #a78bfa;
    --brand-500: #8b5cf6;
    --brand-600: #7c3aed;  /* primary buttons, active nav (light mode)   */
    --brand-700: #6d28d9;  /* button hover, active nav (dark mode)       */
    --brand-800: #5b21b6;
    --brand-900: #4c1d95;
    --brand-950: #2e1065;  /* darkest shade                              */
}
